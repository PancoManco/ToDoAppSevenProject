
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip

	handle /oauth2/* {
		reverse_proxy auth-service:8081
	}
	handle /login/oauth2/* {
		reverse_proxy auth-service:8081
	}

	handle /api/* {
		reverse_proxy api-gateway:8080
	}

	handle {
		reverse_proxy frontend:80
	}


	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
