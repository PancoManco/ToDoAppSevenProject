# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║                                                                           ║
# ║                 🚀 ToDo App — PRODUCTION Environment                      ║
# ║                                                                           ║
# ║   ⚠️ THIS FILE CONTAINS REAL SECRETS — NEVER COMMIT TO GIT!               ║
# ║                                                                           ║
# ║                                                                           ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
# ┃ 🚨 CRITICAL SECRETS (Generate with: ./generate-prod-secrets.sh)         ┃
# ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

# ── 🔐 RSA Key Pair (JWT signing) ─────────────────────────────────────────
RSA_PRIVATE_KEY_BASE64=
RSA_PUBLIC_KEY_BASE64=

# ── 🔑 Internal API Key (scheduler ↔ task-service) ───────────────────────
INTERNAL_API_KEY=

# ── ⚡ Redis Password ────────────────────────────────────────────────────
REDIS_PASSWORD=

# ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
# ┃ 🗄️ DATABASES (Generated passwords — keep secure!)                       ┃
# ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

# ── 🔐 Auth Service DB ───────────────────────────────────────────────────
AUTH_DB_NAME=auth_db
AUTH_DB_USER=authuser_prod
AUTH_DB_PASSWORD=

# ── 📋 Task Service DB ───────────────────────────────────────────────────
TASK_DB_NAME=task_db
TASK_DB_USER=taskuser_prod
TASK_DB_PASSWORD=

# ── 📧 Email Sender DB ───────────────────────────────────────────────────
EMAIL_DB_NAME=email_db
EMAIL_DB_USER=emailuser_prod
EMAIL_DB_PASSWORD=

# ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
# ┃ 🌐 PRODUCTION ENDPOINTS (Replace with your real domain!)                ┃
# ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

# ── 🏠 Your Domain ───────────────────────────────────────────────────────
# ⚠️  REPLACE 'yourdomain.com' with your actual domain (e.g. todoapp.com)
FRONTEND_ORIGIN=https://yourdomain.com
OAUTH_SUCCESS_REDIRECT_URI=https://yourdomain.com/oauth2/success
OAUTH_FAILURE_REDIRECT_URI=https://yourdomain.com/login?error=oauth_failed

# ── 🔗 Internal Service URLs (Docker network — DO NOT CHANGE) ────────────
AUTH_SERVICE_URL=http://auth-service:8081
TASK_SERVICE_URL=http://task-service:8082
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
REDIS_HOST=redis
REDIS_PORT=6379

# ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
# ┃ 📧 SMTP / MAIL (Configure with real SMTP provider)                      ┃
# ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

# ── 📮 SMTP Configuration ────────────────────────────────────────────────
# Examples: Gmail SMTP, SendGrid, Mailgun, AWS SES, Yandex 360
MAIL_HOST=smtp.yourdomain.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@yourdomain.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
MAIL_DEFAULT_LOCALE=ru

# ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
# ┃ 🌍 GOOGLE OAUTH2 (Optional — leave empty if not used)                   ┃
# ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

# ── 🔑 Google OAuth2 Credentials ─────────────────────────────────────────
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://yourdomain.com/login/oauth2/code/google
APP_OAUTH2_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
# ┃ ⚙️ APPLICATION SETTINGS (Production values)                             ┃
# ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

# ── 🎫 JWT Settings ──────────────────────────────────────────────────────
JWT_ISSUER=ToDoApp-Production

# ── 🍪 Cookie Security (MUST be true in production with HTTPS!) ──────────
COOKIE_SECURE=true
COOKIE_SAME_SITE=None

# ── 🌐 CORS (Disabled in production — Nginx handles it) ──────────────────
CORS_ENABLED=false

# ── 🚦 Rate Limiting (Enabled in production) ─────────────────────────────
RATE_LIMIT_ENABLED=true

# ── ☕ Java JVM Options ──────────────────────────────────────────────────
JAVA_TOOL_OPTIONS=-Xmx512m -Xms256m -XX:+UseG1GC -XX:MaxRAMPercentage=75.0

# ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
# ┃ ⏰ SCHEDULER & OUTBOX (Cron jobs)                                       ┃
# ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

# ── 📅 Daily Report Scheduler ────────────────────────────────────────────
# Spring cron = 6 fields: sec min hour day month day-of-week
# Default: daily at 08:00 AM
REPORT_TOPIC=report-events
REPORT_CRON=0 0 8 * * *

# ── 📮 Outbox Pattern ────────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_CLEANUP_CRON=0 0 2 * * *

# ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
# ┃ 📊 LOGGING & MONITORING                                                 ┃
# ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

# ── 📝 Log Levels (production = WARN for most, INFO for app) ─────────────
LOG_APP=INFO
LOG_SECURITY=WARN
LOG_WEB=WARN
LOG_SQL=WARN
LOG_KAFKA=WARN
LOG_MAIL=WARN
LOG_GATEWAY=INFO
LOG_NETTY=WARN
LOG_RESILIENCE=WARN
LOG_SCHEDULING=INFO

# ── 🏥 Actuator Health (hide details in production) ──────────────────────
HEALTH_DETAILS=never

# ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
# ┃ 🐳 DOCKER HUB (For CI/CD — set in GitHub Secrets, not here)            ┃
# ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

DOCKERHUB_USERNAME=pancomanco
