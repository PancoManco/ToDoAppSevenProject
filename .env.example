# ============================================================
#  SPRING PROFILE
# ============================================================
# dev | prod | test
SPRING_PROFILES_ACTIVE=dev

# ============================================================
#  SHARED / COMMON
# ============================================================
# Kafka (used: auth-service, email-sender, scheduler)
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Redis (used: api-gateway, auth-service)
REDIS_HOST=localhost
REDIS_PORT=6379

# Mailpit / SMTP (used: auth-service, email-sender)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLE=false
MAIL_STARTTLS_REQUIRED=false
MAIL_FROM=no-reply@todo.local

# Service URLs
AUTH_SERVICE_URL=http://localhost:8081
TASK_SERVICE_URL=http://localhost:8082
EMAIL_SENDER_URL=http://localhost:8083
SCHEDULER_URL=http://localhost:8084

# ============================================================
# Service URLs
# ============================================================
AUTH_SERVICE_URL=http://localhost:8081
TASK_SERVICE_URL=http://localhost:8082
EMAIL_SENDER_URL=http://localhost:8083
SCHEDULER_URL=http://localhost:8084

# ============================================================
#  API GATEWAY PORT
# ============================================================
API_GATEWAY_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# ============================================================
#  AUTH SERVICE PORT
# ============================================================
AUTH_SERVICE_PORT=8081

# --- Frontend URLs (OAuth2 redirects) ---
OAUTH_SUCCESS_REDIRECT_URI=http://localhost:5173/oauth-success
OAUTH_FAILURE_REDIRECT_URI=http://localhost:5173/login?oauthError=true

# --- JWT ---
JWT_ISSUER=toDoApplication
JWT_ACCESS_TOKEN_TTL_MINUTES=5
JWT_REFRESH_TOKEN_TTL_DAYS=7

# --- Cookie ---
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# --- Database (Postgres 5432) ---
DATASOURCE_URL=jdbc:postgresql://localhost:5432/your_db
DATASOURCE_USERNAME=
DATASOURCE_PASSWORD=
DATASOURCE_DRIVER=org.postgresql.Driver

# --- Rate limiting (Bucket4j) ---
RATE_LIMIT_ENABLED=true

# --- Outbox Pattern ---
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_CLEANUP_CRON=0 0 2 * * *

# --- OAuth2 Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- RSA Keys (Base64 encoded PEM) ---
RSA_PRIVATE_KEY_BASE64=
RSA_PUBLIC_KEY_BASE64=

# ============================================================
#  TASK SERVICE  (port 8082)
# ============================================================
TASK_SERVICE_PORT=8082

# --- Database (Postgres 5433) ---
TASK_DATASOURCE_URL=jdbc:postgresql://localhost:5433/your_db
TASK_DATASOURCE_USERNAME=
TASK_DATASOURCE_PASSWORD=

# ============================================================
#  EMAIL SENDER  (port 8083)
# ============================================================
EMAIL_SENDER_PORT=8083

# --- Database (Postgres 5434) ---
EMAIL_DATASOURCE_URL=jdbc:postgresql://localhost:5434/your_db
EMAIL_DATASOURCE_USERNAME=
EMAIL_DATASOURCE_PASSWORD=

# --- Kafka consumer ---
KAFKA_CONSUMER_GROUP=email-sender

# ============================================================
#  SCHEDULER  (port 8084)
# ============================================================
SCHEDULER_PORT=8084

# --- Report config ---
REPORT_TOPIC=report-events
# Every 6 hours by default
REPORT_CRON=0 */6 * * *
