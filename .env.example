
# ============================================================
#  1. SECRETS (required — services won't start without them)
# ============================================================

# RSA keys for signing JWTs (base64-encoded PEM)
RSA_PRIVATE_KEY_BASE64=
RSA_PUBLIC_KEY_BASE64=

# Secret for service-to-service calls (scheduler -> task /internal/**).
# Generate: openssl rand -base64 32
INTERNAL_API_KEY=

# OAuth2 Google (leave empty if Google sign-in is not used)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_OAUTH2_ENABLED=false

# CORS (local = true and prod(with nginx)=false
CORS_ENABLED=

# Redis
REDIS_PASSWORD=
FRONTEND_ORIGIN= (http://localhost with nginx)

# ============================================================
#  2. DATABASES
# ============================================================

# auth-service DB
AUTH_DB_USER=authuser
AUTH_DB_PASSWORD=
AUTH_DB_NAME=auth_db

# task-service DB
TASK_DB_USER=taskuser
TASK_DB_PASSWORD=
TASK_DB_NAME=task_db

# email-sender DB
EMAIL_DB_USER=emailuser
EMAIL_DB_PASSWORD=
EMAIL_DB_NAME=email_db


# ============================================================
#  3. APPLICATION SETTINGS (same for IDE and Docker)
# ============================================================

# --- JWT ---
JWT_ISSUER=toDoApplication
JWT_ACCESS_TOKEN_TTL_MINUTES=5
JWT_REFRESH_TOKEN_TTL_DAYS=7

# --- Frontend / CORS / OAuth redirects ---
FRONTEND_ORIGIN=http://localhost:5173
OAUTH_SUCCESS_REDIRECT_URI=http://localhost:5173/oauth-success
OAUTH_FAILURE_REDIRECT_URI=http://localhost:5173/login?oauthError=true

# --- Cookie (secure=true only under HTTPS / production) ---
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# --- Mail (SMTP credentials/mode; host address is in section 4) ---
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLE=false
MAIL_STARTTLS_REQUIRED=false
MAIL_FROM=no-reply@todo.local
MAIL_DEFAULT_LOCALE=ru or eng

# --- Outbox (auth) ---
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_CLEANUP_CRON=0 0 2 * * *

# --- Scheduler ---
REPORT_TOPIC=report-events
# Spring cron = 6 fields (sec min hour day month day-of-week).
# Midnight every day. For testing — every minute: 0 * * * * *
REPORT_CRON=0 0 0 * * *

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RL_REGISTER_RATE=10
RL_REGISTER_BURST=20
RL_LOGIN_RATE=2
RL_LOGIN_BURST=3
RL_VERIFY_RATE=30
RL_VERIFY_BURST=50
RL_PASSWORD_RATE=10
RL_PASSWORD_BURST=20
RL_REFRESH_RATE=30
RL_REFRESH_BURST=50

# --- Logging / Health (empty = application.yml defaults: INFO/WARN, never) ---
# For debugging use DEBUG, e.g. LOG_SECURITY=DEBUG
LOG_APP
LOG_GATEWAY
LOG_SECURITY
LOG_NETTY
LOG_RESILIENCE
LOG_WEB
LOG_SQL
LOG_SQL_BIND
LOG_KAFKA
LOG_MAIL
LOG_CIRCUIT_BREAKER
LOG_RETRY
LOG_SCHEDULING
LOG_CACHE
LOG_REDIS
HEALTH_DETAILS=never
HIBERNATE_FORMAT_SQL=false


# ============================================================
#  4. SERVICE & INFRASTRUCTURE ADDRESSES
# ============================================================

# --- Service ports (host mapping; fixed inside Docker) ---
# API_GATEWAY_PORT=8080
# AUTH_SERVICE_PORT=8081
# TASK_SERVICE_PORT=8082
# EMAIL_SENDER_PORT=8083
# SCHEDULER_PORT=8084

# --- Inter-service URLs ---
# AUTH_SERVICE_URL=http://localhost:8081       # Docker: http://auth-service:8081
# TASK_SERVICE_URL=http://localhost:8082       # Docker: http://task-service:8082

# --- Kafka ---
# KAFKA_BOOTSTRAP_SERVERS=localhost:29092      # Docker: kafka:9092
# KAFKA_CONSUMER_GROUP=email-sender

# --- Redis ---
# REDIS_HOST=localhost                          # Docker: redis
# REDIS_PORT=6379

# --- Mail host ---
# MAIL_HOST=localhost                           # Docker: mailpit
# MAIL_PORT=1025

# --- Datasource URLs (built from host:port/db) ---
# AUTH_DATASOURCE_URL=jdbc:postgresql://localhost:5432/auth_db    # Docker: postgres:5432
# TASK_DATASOURCE_URL=jdbc:postgresql://localhost:5433/task_db     # Docker: task-postgres:5432
# EMAIL_DATASOURCE_URL=jdbc:postgresql://localhost:5434/email_db   # Docker: email-sender-postgres:5432

# --- DB host port mappings (external port on the host) ---
# AUTH_DB_PORT=5432
# TASK_DB_PORT=5433
# EMAIL_DB_PORT=5434
# KAFKA_EXTERNAL_PORT=29092
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025