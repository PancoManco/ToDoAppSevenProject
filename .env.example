# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║                                                                           ║
# ║                   📋 ToDo App — Environment Configuration                 ║
# ║                                                                           ║
# ║   Copy this file to .env and fill in the values:                          ║
# ║   $ cp .env.example .env && nano .env                                     ║
# ║                                                                           ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
# ┃ 🔴 1. CRITICAL SECRETS (Required — services won't start without them)    ┃
# ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

# ── 🔐 RSA Key Pair (JWT signing) ─────────────────────────────────────────
RSA_PRIVATE_KEY_BASE64=
RSA_PUBLIC_KEY_BASE64=

# ── 🔑 Internal API Key (scheduler ↔ task-service) ───────────────────────
INTERNAL_API_KEY=

# ── 🌐 OAuth2 Google (optional) ──────────────────────────────────────────
# Console: https://console.cloud.google.com/apis/credentials
# Leave empty + APP_OAUTH2_ENABLED=false to disable Google sign-in
APP_OAUTH2_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 🛡️ CORS ──────────────────────────────────────────────────────────────
# Local dev:    CORS_ENABLED=true,  FRONTEND_ORIGIN=http://localhost:5173
# Prod (nginx): CORS_ENABLED=false, FRONTEND_ORIGIN=<your-domain>
CORS_ENABLED=true
FRONTEND_ORIGIN=http://localhost:5173

# ── ⚡ Redis ──────────────────────────────────────────────────────────────
REDIS_PASSWORD=
RATE_LIMIT_ENABLED=true

# ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
# ┃ 🟡 2. DATABASES (PostgreSQL credentials)                                ┃
# ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

# ── 🔐 Auth Service DB ───────────────────────────────────────────────────
AUTH_DB_USER=authuser
AUTH_DB_PASSWORD=
AUTH_DB_NAME=auth_db

# ── 📋 Task Service DB ───────────────────────────────────────────────────
TASK_DB_USER=taskuser
TASK_DB_PASSWORD=
TASK_DB_NAME=task_db

# ── 📧 Email Sender DB ───────────────────────────────────────────────────
EMAIL_DB_USER=emailuser
EMAIL_DB_PASSWORD=
EMAIL_DB_NAME=email_db

# ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
# ┃ 🟢 3. APPLICATION SETTINGS (Same for IDE and Docker)                    ┃
# ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

# ── 🎫 JWT Settings ──────────────────────────────────────────────────────
JWT_ISSUER=toDoApplication
JWT_ACCESS_TOKEN_TTL_MINUTES=5
JWT_REFRESH_TOKEN_TTL_DAYS=7

# ── 🍪 Cookie Security ───────────────────────────────────────────────────
# COOKIE_SECURE=true only in production (HTTPS required!)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# ── 🔀 OAuth2 Redirects ──────────────────────────────────────────────────
OAUTH_SUCCESS_REDIRECT_URI=http://localhost:5173/oauth-success
OAUTH_FAILURE_REDIRECT_URI=http://localhost:5173/login?oauthError=true

# ── 📧 Mail / SMTP ───────────────────────────────────────────────────────
# Local: Mailpit (no auth). Prod: real SMTP server
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLE=false
MAIL_STARTTLS_REQUIRED=false
MAIL_FROM=no-reply@todo.local
MAIL_DEFAULT_LOCALE=ru                # Options: ru, en

# ── 📮 Outbox Pattern (auth-service → Kafka) ─────────────────────────────
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_CLEANUP_CRON=0 0 2 * * *      # Daily at 02:00

# ── ⏰ Scheduler (daily reports) ─────────────────────────────────────────
REPORT_TOPIC=report-events
# Spring cron = 6 fields: sec min hour day month day-of-week
# Production (daily at midnight): 0 0 0 * * *
# Testing (every minute):         0 * * * * *
REPORT_CRON=0 0 0 * * *

# ── 🚦 Rate Limiting (Bucket4j + Redis) ──────────────────────────────────
# Format: <rate> requests per second, <burst> max bucket size
RL_REGISTER_RATE=10
RL_REGISTER_BURST=20
RL_LOGIN_RATE=2
RL_LOGIN_BURST=3
RL_VERIFY_RATE=30
RL_VERIFY_BURST=50
RL_PASSWORD_RATE=10
RL_PASSWORD_BURST=20
RL_REFRESH_RATE=30
RL_REFRESH_BURST=50

# ── 📊 Logging Levels ────────────────────────────────────────────────────
# Options: TRACE, DEBUG, INFO, WARN, ERROR
# Leave empty to use application.yml defaults
LOG_APP=
LOG_GATEWAY=
LOG_SECURITY=
LOG_NETTY=
LOG_RESILIENCE=
LOG_WEB=
LOG_SQL=
LOG_SQL_BIND=
LOG_KAFKA=
LOG_MAIL=
LOG_CIRCUIT_BREAKER=
LOG_RETRY=
LOG_SCHEDULING=
LOG_CACHE=
LOG_REDIS=

# ── 🏥 Actuator / Health ─────────────────────────────────────────────────
HEALTH_DETAILS=never                  # Options: never, always, when_authorized
HIBERNATE_FORMAT_SQL=false


# ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
# ┃ 🔵 4. INFRASTRUCTURE (Environment-specific — override per profile)      ┃
# ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
#
# 💡 Values below differ between local dev (IDE) and Docker.
#    docker-compose.yml injects its own values, so you usually don't need
#    to uncomment these for Docker runs.
#
# ── 🚪 Service Ports (host mapping; inside Docker these are fixed) ──────
# API_GATEWAY_PORT=8080
# AUTH_SERVICE_PORT=8081
# TASK_SERVICE_PORT=8082
# EMAIL_SENDER_PORT=8083
# SCHEDULER_PORT=8084
#
# ── 🔗 Inter-service URLs ───────────────────────────────────────────────
# Local:  http://localhost:8081
# Docker: http://auth-service:8081
# AUTH_SERVICE_URL=http://localhost:8081
# TASK_SERVICE_URL=http://localhost:8082
#
# ── 📨 Kafka ────────────────────────────────────────────────────────────
# Local:  localhost:29092
# Docker: kafka:9092
# KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# KAFKA_CONSUMER_GROUP=email-sender
#
# ── ⚡ Redis ────────────────────────────────────────────────────────────
# Local:  localhost
# Docker: redis
# REDIS_HOST=localhost
# REDIS_PORT=6379
#
# ── 📬 Mail Host ────────────────────────────────────────────────────────
# Local (Mailpit): localhost:1025   |   UI: http://localhost:8025
# Docker:          mailpit:1025
# MAIL_HOST=localhost
# MAIL_PORT=1025
#
# ── 🗄️ Datasource URLs ─────────────────────────────────────────────────
# Local ports:  5432 (auth), 5433 (task), 5434 (email)
# Docker hosts: auth-postgres, task-postgres, email-postgres
# AUTH_DATASOURCE_URL=jdbc:postgresql://localhost:5432/auth_db
# TASK_DATASOURCE_URL=jdbc:postgresql://localhost:5433/task_db
# EMAIL_DATASOURCE_URL=jdbc:postgresql://localhost:5434/email_db
#
# ── 🌐 External Port Mappings (host side) ──────────────────────────────
# AUTH_DB_PORT=5432
# TASK_DB_PORT=5433
# EMAIL_DB_PORT=5434
# KAFKA_EXTERNAL_PORT=29092
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025